      },
      "execStdinData": {
        "name": "execStdinData",
        "title": "stdin data (0x00)",
        "summary": "stdin data. Frame prefix: `0x00`.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "string",
          "format": "binary",
          "description": "stdin data. Frame prefix: `0x00`."
        },
        "examples": [
          {
            "name": "frame",
            "summary": "Example frame",
            "payload": "0x00 0x6c 0x73 0x0a (sends 'ls\\n')"
          }
        ]
      },
      "execStdoutData": {
        "name": "execStdoutData",
        "title": "stdout data (0x01)",
        "summary": "stdout data. Frame prefix: `0x01`.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "string",
          "format": "binary",
          "description": "stdout data. Frame prefix: `0x01`."
        },
        "examples": [
          {
            "name": "frame",
            "summary": "Example frame",
            "payload": "0x01 0x66 0x6f 0x6f 0x0a (receives 'foo\\n')"
          }
        ]
      },
      "execStderrData": {
        "name": "execStderrData",
        "title": "stderr data (0x02)",
        "summary": "stderr data. Frame prefix: `0x02`.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "string",
          "format": "binary",
          "description": "stderr data. Frame prefix: `0x02`."
        },
        "examples": [
          {
            "name": "frame",
            "summary": "Example frame",
            "payload": "0x02 0x65 0x72 0x72 0x6f 0x72 0x0a (receives 'error\\n')"
          }
        ]
      },
      "execExitCode": {
        "name": "execExitCode",
        "title": "exit code (single byte) (0x03)",
        "summary": "exit code (single byte). Frame prefix: `0x03`.",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "string",
          "format": "binary",
          "description": "exit code (single byte). Frame prefix: `0x03`."
