      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sprites API token in the form `<org>/<id>/<secret>`, sent as `Authorization: Bearer <token>` on the upgrade request."
      }
    },
    "messages": {
      "ExitMessage": {
        "name": "ExitMessage",
        "title": "ExitMessage",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/ExitMessage"
        },
        "examples": [
          {
            "name": "default",
            "payload": {
              "exit_code": 0,
              "type": "exit"
            }
          }
        ]
      },
      "PortListMessage": {
        "name": "PortListMessage",
        "title": "PortListMessage",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/PortListMessage"
