      "proxyRawTcpData": {
        "name": "proxyRawTcpData",
        "title": "Raw TCP data forwarded without framing ((none))",
        "summary": "Raw TCP data forwarded without framing",
        "contentType": "application/octet-stream",
        "payload": {
          "type": "string",
          "format": "binary",
          "description": "Raw TCP data forwarded without framing"
        },
        "examples": [
          {
            "name": "frame",
            "summary": "Example frame",
            "payload": "After init message, raw bytes flow directly: 0x47 0x45 0x54 0x20 0x2f ... (HTTP request 'GET /')"
          }
        ]
      }
    },
    "schemas": {
      "PortNotificationMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "port_opened",
              "port_closed"
            ],
            "description": "Notification type"
          },
          "port": {
            "type": "integer",
            "description": "Port number"
          },
          "address": {
            "type": "string",
            "description": "Proxy URL for accessing the port"
          },
          "pid": {
            "type": "integer",
            "description": "Process ID that opened/closed the port"
          }
        },
        "required": [
          "type",
          "port",
          "address",
          "pid"
        ],
        "examples": [
          {
            "address": "https://my-sprite.sprites.dev:3000",
            "pid": 1847,
            "port": 3000,
            "type": "port_opened"
          }
        ]
      },
      "ExitMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "exit"
          },
          "exit_code": {
            "type": "integer",
            "description": "Process exit code"
          }
        },
        "required": [
          "type",
          "exit_code"
        ],
        "examples": [
          {
            "exit_code": 0,
            "type": "exit"
          }
        ]
      },
      "PortListMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "port_list"
          },
          "ports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortNotificationMessage"
            }
          }
        },
        "required": [
          "type",
          "ports"
        ]
      },
      "ProxyInitMessage": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "description": "Target hostname (typically \"localhost\")"
          },
          "port": {
            "type": "integer",
            "description": "Target port (1-65535)"
          }
        },
        "required": [
          "host",
          "port"
        ],
        "examples": [
          {
            "host": "localhost",
            "port": 5432
          }
        ]
      },
      "ResizeMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "resize"
          },
          "cols": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "New column count"
          },
          "rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "New row count"
          }
        },
        "required": [
          "type",
          "cols",
          "rows"
        ],
        "examples": [
          {
            "cols": 180,
            "rows": 50,
            "type": "resize"
          }
        ]
      },
      "SessionInfoMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "session_info"
          },
          "session_id": {
            "type": "string",
            "description": "Session ID"
          },
          "command": {
            "type": "string",
            "description": "Command being executed"
          },
          "created": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp of session creation"
          },
          "cols": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Terminal columns (TTY mode only)"
          },
          "rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Terminal rows (TTY mode only)"
          },
          "is_owner": {
            "type": "boolean",
            "description": "Whether this attachment owns the session"
          },
          "tty": {
            "type": "boolean",
            "description": "Whether session is in TTY mode"
          }
        },
        "required": [
          "type",
          "session_id",
          "command",
          "created",
          "cols",
          "rows",
          "is_owner",
          "tty"
        ],
        "examples": [
          {
            "cols": 120,
            "command": "bash",
            "created": 1767609000,
            "is_owner": true,
            "rows": 40,
            "session_id": "1847",
            "tty": true,
            "type": "session_info"
          }
        ]
      },
      "WatchMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recursive": {
            "type": "boolean"
          },
          "workingDir": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "isDir": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      }
    }
  }
}
