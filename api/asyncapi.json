{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Sprites API: WebSocket",
    "version": "v0.0.1-rc48",
    "description": "WebSocket surface of the Sprites API: exec sessions, TCP port tunnelling,\nfilesystem watching, port watching, and the multiplexed control channel.\n\n## Perspective\n\nOperations are documented from the perspective of the **Sprites API server**:\n\n* `action: receive` for messages the server receives from the client.\n* `action: send` for messages the server sends to the client.\n\n## Authentication\n\nConnections authenticate with `Authorization: Bearer <token>` on the HTTP upgrade\nrequest. Tokens have the form `<org>/<id>/<secret>`. A successful upgrade returns\n`101 Switching Protocols`.\n\n## Framing\n\nChannels carry a mix of JSON control messages and binary data frames. Binary\nframes on exec channels are prefixed with a single stream byte\n(`0x00` stdin, `0x01` stdout, `0x02` stderr, `0x03` exit code, `0x04` stdin EOF).\nThe proxy channel forwards raw TCP bytes with no framing after its init message.\n\n---\n\nTranslated from sprite-environment schema `v0.0.1-rc48` (generated `2026-08-14T23:33:28.44474263Z`).\n",
    "contact": {
      "name": "Fly.io",
      "url": "https://sprites.dev"
    }
  },
  "defaultContentType": "application/json",
  "servers": {
    "production": {
      "host": "api.sprites.dev",
      "protocol": "wss",
      "description": "Production",
      "security": [
        {
          "$ref": "#/components/securitySchemes/bearerAuth"
        }
      ]
    }
  },
  "channels": {
    "exec": {
      "address": "/v1/sprites/{name}/exec",
      "title": "Execute Command",
      "description": "Execute a command in the sprite environment via WebSocket. Commands continue running after disconnect; use `max_run_after_disconnect` to control timeout. Supports TTY and non-TTY modes.",
      "parameters": {
        "name": {
          "description": "Sprite name within the organization."
        }
      },
      "messages": {
        "ResizeMessage": {
          "$ref": "#/components/messages/ResizeMessage"
        },
        "SessionInfoMessage": {
          "$ref": "#/components/messages/SessionInfoMessage"
        },
        "ExitMessage": {
          "$ref": "#/components/messages/ExitMessage"
        },
        "PortNotificationMessage": {
          "$ref": "#/components/messages/PortNotificationMessage"
        },
        "execStdinData": {
          "$ref": "#/components/messages/execStdinData"
        },
        "execStdoutData": {
          "$ref": "#/components/messages/execStdoutData"
        },
        "execStderrData": {
          "$ref": "#/components/messages/execStderrData"
        },
        "execExitCode": {
          "$ref": "#/components/messages/execExitCode"
        },
        "execStdinEofSignal": {
          "$ref": "#/components/messages/execStdinEofSignal"
        }
      }
    },
    "execBySessionId": {
      "address": "/v1/sprites/{name}/exec/{session_id}",
      "title": "Attach to Exec Session",
      "description": "Attach to an existing exec session via WebSocket.",
      "parameters": {
        "name": {
          "description": "Sprite name within the organization."
        },
        "session_id": {
          "description": "Exec session identifier."
        }
      },
      "messages": {
        "ResizeMessage": {
          "$ref": "#/components/messages/ResizeMessage"
        },
        "SessionInfoMessage": {
          "$ref": "#/components/messages/SessionInfoMessage"
        },
        "ExitMessage": {
          "$ref": "#/components/messages/ExitMessage"
        }
      }
    },
    "proxy": {
      "address": "/v1/sprites/{name}/proxy",
      "title": "TCP Proxy",
      "description": "Establish a WebSocket tunnel to a port inside the sprite environment.",
      "parameters": {
        "name": {
          "description": "Sprite name within the organization."
        }
      },
      "messages": {
        "ProxyInitMessage": {
          "$ref": "#/components/messages/ProxyInitMessage"
        },
        "proxyRawTcpData": {
          "$ref": "#/components/messages/proxyRawTcpData"
        }
      }
    },
    "control": {
      "address": "/v1/sprites/{name}/control",
      "title": "Control Channel",
      "description": "Multiplexed control channel for sequential operations (exec, proxy) over a single persistent WebSocket connection. Reduces connection overhead for clients sending many operations.",
      "parameters": {
        "name": {
          "description": "Sprite name within the organization."
        }
      }
    },
    "portsWatch": {
      "address": "/v1/sprites/{name}/ports/watch",
      "title": "Watch Ports",
      "description": "Watch for port open/close events across all processes in the sprite namespace. On connect, sends a snapshot of all currently listening ports as a port_list message, then streams incremental port_opened/port_closed events.",
      "parameters": {
        "name": {
          "description": "Sprite name within the organization."
        }
      },
      "messages": {
        "PortListMessage": {
          "$ref": "#/components/messages/PortListMessage"
        },
        "PortNotificationMessage": {
          "$ref": "#/components/messages/PortNotificationMessage"
        }
      }
    },
    "fsWatch": {
      "address": "/v1/sprites/{name}/fs/watch",
      "title": "Watch Filesystem",
      "description": "Watch for filesystem changes via WebSocket.",
      "parameters": {
        "name": {
          "description": "Sprite name within the organization."
        }
      },
      "messages": {
        "WatchMessage": {
          "$ref": "#/components/messages/WatchMessage"
        }
      }
    }
  },
  "operations": {
    "execReceive": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/exec"
      },
      "title": "Execute Command: messages from client",
      "summary": "Messages the Sprites API receives from the client.",
      "messages": [
        {
          "$ref": "#/channels/exec/messages/ResizeMessage"
        },
        {
          "$ref": "#/channels/exec/messages/execStdinData"
        },
        {
          "$ref": "#/channels/exec/messages/execStdinEofSignal"
        }
      ]
    },
    "execSend": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/exec"
      },
      "title": "Execute Command: messages to client",
      "summary": "Messages the Sprites API sends to the client.",
      "messages": [
        {
          "$ref": "#/channels/exec/messages/SessionInfoMessage"
        },
        {
          "$ref": "#/channels/exec/messages/ExitMessage"
        },
        {
          "$ref": "#/channels/exec/messages/PortNotificationMessage"
        },
        {
          "$ref": "#/channels/exec/messages/execStdoutData"
        },
        {
          "$ref": "#/channels/exec/messages/execStderrData"
        },
        {
          "$ref": "#/channels/exec/messages/execExitCode"
        }
      ]
    },
    "execBySessionIdReceive": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/execBySessionId"
      },
      "title": "Attach to Exec Session: messages from client",
      "summary": "Messages the Sprites API receives from the client.",
      "messages": [
        {
          "$ref": "#/channels/execBySessionId/messages/ResizeMessage"
        }
      ]
    },
    "execBySessionIdSend": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/execBySessionId"
      },
      "title": "Attach to Exec Session: messages to client",
      "summary": "Messages the Sprites API sends to the client.",
      "messages": [
        {
          "$ref": "#/channels/execBySessionId/messages/SessionInfoMessage"
        },
        {
          "$ref": "#/channels/execBySessionId/messages/ExitMessage"
        }
      ]
    },
    "proxyReceive": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/proxy"
      },
      "title": "TCP Proxy: messages from client",
      "summary": "Messages the Sprites API receives from the client.",
      "messages": [
        {
          "$ref": "#/channels/proxy/messages/ProxyInitMessage"
        },
        {
          "$ref": "#/channels/proxy/messages/proxyRawTcpData"
        }
      ]
    },
    "proxySend": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/proxy"
      },
      "title": "TCP Proxy: messages to client",
      "summary": "Messages the Sprites API sends to the client.",
      "messages": [
        {
          "$ref": "#/channels/proxy/messages/proxyRawTcpData"
        }
      ]
    },
    "portsWatchSend": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/portsWatch"
      },
      "title": "Watch Ports: messages to client",
      "summary": "Messages the Sprites API sends to the client.",
      "messages": [
        {
          "$ref": "#/channels/portsWatch/messages/PortListMessage"
        },
        {
          "$ref": "#/channels/portsWatch/messages/PortNotificationMessage"
        }
      ]
    },
    "fsWatchReceive": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/fsWatch"
      },
      "title": "Watch Filesystem: messages from client",
      "summary": "Messages the Sprites API receives from the client.",
      "messages": [
        {
          "$ref": "#/channels/fsWatch/messages/WatchMessage"
        }
      ]
    },
    "fsWatchSend": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/fsWatch"
      },
      "title": "Watch Filesystem: messages to client",
      "summary": "Messages the Sprites API sends to the client.",
      "messages": [
        {
          "$ref": "#/channels/fsWatch/messages/WatchMessage"
        }
      ]
    }
  },
  "components": {
